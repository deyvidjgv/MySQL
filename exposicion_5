-- CONSULTA SIMPLIFICADA
SELECT p.nombre AS producto, v.cantidad, p.precio,
       (v.cantidad * p.precio) AS subtotal
FROM venta v
JOIN producto p ON v.producto_id = p.id
WHERE v.id = 1;
